{
  "name": "lifeboard-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GraphQL-сервер трекера: аккаунты, 2FA, синхронизация коллекций",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "check:queries": "node scripts/check-queries.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@pothos/core": "^4.3.0",
    "@prisma/client": "^6.2.1",
    "@simplewebauthn/server": "^13.0.0",
    "fastify": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.11",
    "nodemailer": "^7.0.0",
    "otpauth": "^9.3.6",
    "prisma": "^6.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
