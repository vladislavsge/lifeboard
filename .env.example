# ─────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и замените значения.
#   cp .env.example .env
# Пароли и ключи сгенерируйте случайно:  openssl rand -hex 32
# Файл .env в git не попадает.
# ─────────────────────────────────────────────────────────────────────

# ── Домен и адреса ───────────────────────────────────────────────────
# dev: localhost. prod: ваш домен, например tracker.example.com
APP_DOMAIN=localhost
# Origin, с которого открывается приложение. Сервер принимает запросы только с него.
# dev: http://localhost:5173    prod: https://tracker.example.com
# Можно перечислить несколько через запятую — например, чтобы открыть с телефона
# в домашней сети: http://localhost:5173,http://192.168.1.50:5173
# Первый адрес основной: он идёт в ссылки писем и в проверку ключей устройств.
APP_ORIGIN=http://localhost:5173
# Порт vite в dev-контейнере. Меняете — поменяйте и порт в APP_ORIGIN.
WEB_PORT=5173
# Почта для Let's Encrypt (нужна только в prod)
ACME_EMAIL=you@example.com
# Порты, которые Caddy занимает на машине (prod)
HTTP_PORT=80
HTTPS_PORT=443
# Если перед контейнерами стоит свой nginx (или туннель) на той же машине,
# TLS заканчивается на нём, а контейнер должен слушать только localhost:
#   WEB_SITE=:80  WEB_BIND=127.0.0.1  HTTP_PORT=8080  HTTPS_PORT=8443
# Пример конфига nginx — docker/nginx/lifeboard.conf
WEB_SITE=
WEB_BIND=

# ── MySQL ────────────────────────────────────────────────────────────
MYSQL_DATABASE=lifeboard
MYSQL_USER=lifeboard
# В пароле лучше только буквы, цифры, - и _ : он подставляется в строку
# подключения mysql://user:пароль@host, и символы @ : / # ? её ломают.
MYSQL_PASSWORD=change-me-please
MYSQL_ROOT_PASSWORD=change-me-too
# Порт MySQL наружу — только в dev (чтобы подключаться клиентом с хоста)
MYSQL_PORT=3306

# ── Сервер ───────────────────────────────────────────────────────────
API_PORT=4000
# Ключ шифрования секретов 2FA в базе. Ровно 64 hex-символа: openssl rand -hex 32
ENCRYPTION_KEY=
# true — регистрация открыта всем (включает подтверждение почты и сброс пароля)
# false — только по инвайт-коду
AUTH_OPEN_REGISTRATION=false
# За reverse proxy (Caddy) сервер должен доверять заголовкам X-Forwarded-*
TRUST_PROXY=true
# Уровень логов: fatal | error | warn | info | debug
LOG_LEVEL=info

# ── Почта ────────────────────────────────────────────────────────────
# dev: Mailpit из docker-compose.dev.yml, письма видно на http://localhost:8025
# prod: smtps://user:pass@smtp.example.com:465
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Трекер <no-reply@localhost>"

# ── Push-уведомления ─────────────────────────────────────────────────
# Ключи получить командой:  cd server && npm run cli -- vapid
# Пусто — уведомления просто выключены, остальное работает как обычно.
# Уведомления требуют HTTPS; на iPhone — только для приложения,
# добавленного «на экран „Домой“».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Строго mailto:адрес или https://… без пробелов и угловых скобок,
# иначе Apple отвечает 403.
VAPID_SUBJECT=

# ── Бэкапы MySQL (prod) ──────────────────────────────────────────────
# Во сколько снимать дамп (время контейнера) и сколько дней держать копии
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
